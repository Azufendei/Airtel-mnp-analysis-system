# Ignore everything
/*

# Keep gitignore + README
!.gitignore
!README.md

# Allow GitHub Actions workflows
!/.github/
!/.github/**

# Allow these folders
!/mnp-ai-bot/
!/mnp-frontend/

# Allow everything inside them
!/mnp-ai-bot/**
!/mnp-frontend/**

# Ignore junk inside allowed folders
**/node_modules/
**/venv/
**/.env
**/__pycache__/
**/.DS_Store
**/.pytest_cache/
**/db_stats_*.json
